{
  "name": "@backoffice/blocks",
  "version": "0.1.0",
  "description": "Page-level building blocks (dashboard, sidebars, login, signup) and charts built from @backoffice/ui.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./*": {
      "source": "./src/*/index.ts",
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.lib.json && cp src/styles.css dist/",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@backoffice/ui": "0.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tabler/icons-react": "^3.31.0",
    "@tanstack/react-table": "^9.0.0",
    "lucide-react": "0.474.0",
    "radix-ui": "^1.4.3",
    "recharts": "3.8.0",
    "sonner": "^2.0.0",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "license": "UNLICENSED",
  "nx": {
    "name": "blocks"
  }
}
