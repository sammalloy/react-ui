{
  "name": "@backoffice/ui",
  "version": "0.1.0",
  "description": "Back Office React component library, built on shadcn/ui, Radix and Tailwind CSS v4.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "source": "./src/styles.css",
      "default": "./dist/styles.css"
    },
    "./lib/utils": {
      "source": "./src/lib/utils.ts",
      "types": "./dist/lib/utils.d.ts",
      "default": "./dist/lib/utils.js"
    },
    "./hooks/*": {
      "source": "./src/hooks/*.ts",
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./*": {
      "source": "./src/components/*.tsx",
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.lib.json && cp src/styles.css src/shadcn.css dist/",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@backoffice/tokens": "0.1.0",
    "@base-ui/react": "1.6.0",
    "@shadcn/react": "^0.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "8.5.2",
    "input-otp": "^1.4.2",
    "lucide-react": "0.474.0",
    "next-themes": "0.4.6",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^9.7.0",
    "react-hook-form": "^7.62.0",
    "react-resizable-panels": "^4",
    "recharts": "3.8.0",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "1.1.2"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@hookform/resolvers": "^3.10.0",
    "date-fns": "^4.1.0",
    "embla-carousel-autoplay": "8.5.2",
    "zod": "^3.25.76"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "license": "UNLICENSED",
  "nx": {
    "name": "ui"
  }
}
